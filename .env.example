# Required for AI Tactical Analyst & Screenshot Analyzer
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: override default Gemini models (defaults shown)
GEMINI_MODEL=gemini-3.1-pro-preview
GEMINI_FAST_MODEL=gemini-3.1-pro-preview

# Optional: server port (defaults to 3000 locally, 8080 in Docker)
PORT=3000
