# Enforce consistent LF line endings across text files
* text=auto eol=lf

# Binary files
*.fm binary
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.woff binary
*.woff2 binary

# Collapse lockfiles and test fixtures in GitHub diffs and language statistics
package-lock.json linguist-generated=true
bun.lock linguist-generated=true
yarn.lock linguist-generated=true
pnpm-lock.yaml linguist-generated=true
src/utils/__fixtures__/** linguist-generated=true
dist/** linguist-generated=true
