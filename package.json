{
  "name": "fm27-command-hub",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node --import tsx server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test src/**/*.test.ts server/**/*.test.ts",
    "test:python": "python3 -m unittest discover -s tests/python -v",
    "test:real-saves": "python3 -m unittest tests.python.test_real_save_regression -v",
    "real-saves:update": "python3 scripts/real-save-manifest.py",
    "audit:decoder": "node --import tsx scripts/audit-decoder-fields.mjs",
    "bench:save-load": "node scripts/benchmark-save-load.mjs",
    "check:fmsave": "node scripts/check-fmsave-upstream.mjs",
    "profile:decode": "node --import tsx scripts/profile-decode-stages.mjs",
    "ui:audit": "node scripts/ui-audit.mjs",
    "device:matrix": "node scripts/device-matrix.mjs",
    "device:webkit": "node scripts/webkit-matrix.mjs",
    "smoke:e2e": "node scripts/e2e-smoke.mjs",
    "a11y:audit": "node scripts/a11y-audit.mjs",
    "verify:precache": "node scripts/verify-precache.mjs"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@google/genai": "^3.6.1",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "compression": "^1.8.2",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "lucide-react": "^1.76.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "virtua": "^0.55.0",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^2.0.0"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "^4.14.1",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite-bundle-analyzer": "^1.3.9"
  }
}
