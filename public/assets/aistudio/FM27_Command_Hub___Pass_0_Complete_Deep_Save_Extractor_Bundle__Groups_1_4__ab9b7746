import { Pass0ExtractionPayload } from '../types/fmSave';
import { WORKER_CACHE_BUSTER } from '../utils/fmSaveHydrator';


export class FmSaveWorkerClient {
  private worker: Worker | null = null;
  private activeRequestId: number = 0;
  private watchdogTimer: ReturnType<typeof setTimeout> | null = null;
  private isJobActive: boolean = false;


  private clearWatchdog() {
    if (this.watchdogTimer !== null) {
      clearTimeout(this.watchdogTimer);
      this.watchdogTimer = null;
    }
  }


  public cancelActiveJob(reason: string = 'Superceded by new save drop') {
    this.clearWatchdog();
    if (this.worker && this.isJobActive) {
      this.worker.terminate();
      this.worker = null;
      this.isJobActive = false;
      console.warn(`[FmSaveWorkerClient] Active job terminated: ${reason}`);
    }
  }


  public async parseFmSaveFile(fileBuffer: ArrayBuffer): Promise<Pass0ExtractionPayload> {
    this.cancelActiveJob('New parse job initiated');


    const requestId = ++this.activeRequestId;
    this.isJobActive = true;
    this.worker = new Worker(new URL('./fmSaveWorker.ts', import.meta.url).href + WORKER_CACHE_BUSTER, {
      type: 'module'
    });


    return new Promise<Pass0ExtractionPayload>((resolve, reject) => {
      const TIMEOUT_MS = 150000; // 150 seconds watchdog budget


      this.watchdogTimer = setTimeout(() => {
        if (this.activeRequestId === requestId) {
          this.cancelActiveJob('Watchdog 150s timeout exceeded');
          reject(new Error('Processing timeout: Save file extraction exceeded 150 seconds budget.'));
        }
      }, TIMEOUT_MS);


      this.worker!.onmessage = (event: MessageEvent) => {
        if (this.activeRequestId !== requestId) return;
        this.clearWatchdog();
        this.isJobActive = false;


        if (event.data.success) {
          resolve(event.data.payload as Pass0ExtractionPayload);
        } else {
          reject(new Error(event.data.error || 'Unknown worker extraction error.'));
        }
      };


      this.worker!.onerror = (err: ErrorEvent) => {
        if (this.activeRequestId !== requestId) return;
        this.clearWatchdog();
        this.isJobActive = false;
        reject(new Error(`Worker execution failed: ${err.message}`));
      };


      this.worker!.postMessage({ requestId, buffer: fileBuffer }, [fileBuffer]);
    });
  }
}
